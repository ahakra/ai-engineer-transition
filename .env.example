# Copy this file to .env and replace all example secrets with unique local values.
# The NiFi section alone is sufficient to run "make nifi-up".

# Apache NiFi - single-user HTTPS login (password MUST be at least 12 characters).
NIFI_USERNAME=admin
NIFI_PASSWORD=passowrdpassword
NIFI_PORT=8443

# Optional PostgreSQL and pgAdmin (for later development).
POSTGRES_DB=ai_transition
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=password
PGADMIN_PORT=5050

# Optional Open WebUI (for local Ollama exploration).
WEBUI_SECRET_KEY=password


NIFI_BASE_URL=https://localhost:8443
NIFI_PROCESS_GROUP_ID=d438b447-01a1-1000-e3cb-92decfcd2d92