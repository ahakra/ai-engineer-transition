POSTGRES_DB=ai_transition
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# pgAdmin browser login (separate from the PostgreSQL credentials).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=password
PGADMIN_PORT=5050

# Open WebUI: replace with a long random value and keep it stable between restarts.
WEBUI_SECRET_KEY=password

# Apache NiFi browser login. Password must be at least 12 characters.
NIFI_USERNAME=admin
NIFI_PASSWORD=password
NIFI_PORT=8443

